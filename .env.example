# ==============================================================================
# APPSEC AUTH & API GATEWAY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/appsec_gateway_db

# Cryptography & Password Hashing
# BCRYPT_SALT_ROUNDS must be >= 12 for defense against GPU/ASIC cracking
BCRYPT_SALT_ROUNDS=12

# JSON Web Tokens (JWT)
# Secrets must have >= 32 characters of high cryptographic entropy in production
JWT_ACCESS_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars!
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie Signing Secret
COOKIE_SECRET=replace_with_cookie_signing_secret_min_32_chars!

# API Gateway Shared Secret Key (Service-to-Service)
GATEWAY_API_KEY=replace_with_gateway_service_secret_api_key_min_32_chars!

# Cross-Origin Resource Sharing (CORS) Whitelist
# Comma-separated list of trusted client origins (No wildcards '*')
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting Parameters
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Request Limits
BODY_LIMIT=10kb

# Observability & Logging (error | warn | info | http | debug)
LOG_LEVEL=info
